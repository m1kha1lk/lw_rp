					"WheelFtR.ry": "if(is_ridden, -move_strafing, 0)",
					"WheelFtR.rx": "-limb_swing*limb_speed/2",
					"WiperL.rz": "if(is_ridden && is_wet, torad(-45)+sin(time/2), 0)",
					"WiperR.rz": "if(is_ridden && is_wet, torad(-60)+sin(time/2), 0)",
					"SteeringWheel.rz": "-move_strafing*2",
					"var.speed": "max(abs(var.prev_x - pos_x), abs(var.prev_z - pos_z)) * 10",
					"var.prev_x": "if(var.prev_x == 0, pos_x, pos_x)",
					"var.prev_z": "if(var.prev_z == 0, pos_z, pos_z)",
					"var.current_speed": "var.current_speed + (var.speed - var.current_speed) * 0.1",
					"Arrow.rz": "torad(min(var.current_speed * 0.23, 1.0) * 180)",
					"Lights.visible": "between(day_time, 12000, 23999) && is_ridden"
				}
			]
