{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:component",
    "component": "minecraft:custom_name",
    "fallback": {
      "type": "minecraft:model",
      "model": "minecraft:block/iron_block"
    },
    "cases": [
      {
        "when": "Дрон",
        "model": {
          "type": "minecraft:model",
          "model": "new_format:item/other/deco/drone/drone/drone"
        }
      },
      {
        "when": "Кейс с дроном",
        "model": {
          "type": "minecraft:select",
          "property": "minecraft:display_context",
          "cases": [
            {
              "when": [
                "firstperson_lefthand",
                "thirdperson_lefthand"
              ],
              "model": {
                "type": "minecraft:model",
                "model": "new_format:item/other/deco/drone/drone_case/drone_case_off"
              }
            }
          ],
          "fallback": {
            "type": "minecraft:model",
            "model": "new_format:item/other/deco/drone/drone_case/drone_case_main"
          }
        }
      },
      {
        "when": "Коричневая кофе машина",
        "model": {
          "type": "minecraft:model",
          "model": "new_format:item/other/deco/espressomachine/brown_espressomachine"
        }
      },
      {
        "when": "Тачка",
        "model": {
          "type": "minecraft:model",
          "model": "new_format:item/other/deco/espressomachine/espressomachine"
        }
      },
      {
        "when": "gray espresso machine",
        "model": {
          "type": "minecraft:model",
          "model": "new_format:item/other/deco/espressomachine/gray_espressomachine"
        }
      },
      {
        "when": "Красная кофе машина",
        "model": {
          "type": "minecraft:model",
          "model": "new_format:item/other/deco/espressomachine/red_espressomachine"
        }
      }
    ]
  }
}